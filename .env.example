# Required: create a token in Envio and replace this placeholder locally.
ENVIO_API_TOKEN=replace-with-envio-api-token

# Optional live-test endpoints. Runtime/cache acceptance requires HTTP(S) in
# RPC_URL. The comparison and Hybrid live tests additionally require a
# WebSocket-capable endpoint via WS_RPC_URL; when omitted, they derive ws(s)
# from RPC_URL for providers that expose both transports at the same path.
# RPC_URL=https://ethereum.example.invalid/rpc
# WS_RPC_URL=wss://ethereum.example.invalid/ws

# Optional for non-mainnet historical comparisons. Mainnet defaults to the
# four documented high-volume contracts; other chains must provide a
# comma-separated address list so a zero-result run cannot pass by accident.
# HYPERSYNC_TEST_CHAIN_ID=1
# HYBRID_LIVE_BACKFILL_BLOCKS=12
# SUBSCRIBER_BENCH_HISTORICAL_ADDRESSES=0x0000000000000000000000000000000000000000

# Safe local listener and durable state path.
EVM_FORK_CACHE_EVENT_LISTEN=127.0.0.1:50051
EVM_FORK_CACHE_EVENT_DB=evm-fork-cache-events.sqlite

# Canonical recovery and polling/request bounds.
EVM_FORK_CACHE_REORG_DEPTH=64
EVM_FORK_CACHE_POLL_INTERVAL_MS=1000
EVM_FORK_CACHE_SOURCE_REQUEST_TIMEOUT_MS=45000
EVM_FORK_CACHE_EVENT_MAX_DELIVERY_BYTES=33554432
EVM_FORK_CACHE_SOURCE_MAX_RESPONSE_BLOCKS=2000
EVM_FORK_CACHE_SOURCE_MAX_RESPONSE_LOGS=10000
EVM_FORK_CACHE_SOURCE_MAX_RESPONSE_DYNAMIC_BYTES=16777216
EVM_FORK_CACHE_SOURCE_MAX_RESIDENT_SESSIONS=4096
EVM_FORK_CACHE_EVENT_MAX_PERSISTED_SESSIONS=65536

# Optional direct authentication/TLS. A non-loopback direct listener requires
# both TLS and bearer authentication. Never commit real values.
# EVM_FORK_CACHE_EVENT_BEARER_TOKEN=replace-with-a-long-random-secret
# EVM_FORK_CACHE_EVENT_TLS_CERT=/run/secrets/tls.crt
# EVM_FORK_CACHE_EVENT_TLS_KEY=/run/secrets/tls.key

# Leave false for loopback or direct TLS plus bearer auth. Set true only when a
# trusted service mesh supplies any missing transport encryption and/or client
# authentication for a non-loopback listener.
EVM_FORK_CACHE_EVENT_TRUSTED_MESH=false

RUST_LOG=info
